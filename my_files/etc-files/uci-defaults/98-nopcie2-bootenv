#!/bin/sh
# Добавить nopcie2 overlay в U-Boot bootconf_extra.
# Это заставит FM350-GL работать в USB/RNDIS режиме по умолчанию.
#
# Чтобы снова включить PCIe2 (без пересборки):
#   fw_setenv bootconf_extra \
#     "$(fw_printenv -n bootconf_extra | sed 's/#mt7988a-bananapi-bpi-r4-nopcie2//')"
#   reboot
#
# Чтобы снова выключить PCIe2:
#   fw_setenv bootconf_extra \
#     "$(fw_printenv -n bootconf_extra)#mt7988a-bananapi-bpi-r4-nopcie2"
#   reboot

OVERLAY="mt7988a-bananapi-bpi-r4-nopcie2"

current=$(fw_printenv -n bootconf_extra 2>/dev/null)
[ -z "$current" ] && exit 0  # fw_env не доступен или env не читается

# Уже установлено — ничего не делаем
echo "$current" | grep -q "$OVERLAY" && exit 0

fw_setenv bootconf_extra "${current}#${OVERLAY}" 2>/dev/null && \
    logger -t nopcie2 "PCIe2 disabled in bootconf_extra for FM350-GL USB mode"

exit 0
