config globals 'globals'
	option mmx_mask '0x3F00'

# Primary: wired WAN. Backup: FB350 (FM350 5G modem).
config interface 'wan'
	option enabled '1'
	option family 'ipv4'
	list track_ip '1.1.1.1'
	list track_ip '8.8.8.8'
	option reliability '1'
	option count '1'
	option timeout '2'
	option interval '5'
	option down '3'
	option up '3'

config interface 'FB350'
	option enabled '1'
	option family 'ipv4'
	list track_ip '1.1.1.1'
	list track_ip '8.8.8.8'
	option reliability '1'
	# Tolerant tracking for mobile internet: 3 pings, 5 s timeout, checked
	# every 10 s, down only after 5 fails (~50 s), up after 2 - avoids false
	# "modem down" on transient cellular latency/handover.
	option count '3'
	option timeout '5'
	option interval '10'
	option down '5'
	option up '2'

config member 'wan_m1'
	option interface 'wan'
	option metric '1'
	option weight '3'

config member 'fb350_m2'
	option interface 'FB350'
	option metric '2'
	option weight '2'

# Prefer wan; fall over to FB350 only when wan's track_ip fails.
config policy 'wan_failover'
	list use_member 'wan_m1'
	list use_member 'fb350_m2'
	option last_resort 'default'

config rule 'default_rule_v4'
	option dest_ip '0.0.0.0/0'
	option family 'ipv4'
	option use_policy 'wan_failover'
