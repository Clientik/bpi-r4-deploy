--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-nopcie2.dtso
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Disable PCIe2 (M.2 Key-B slot CN16) on BPI-R4.
+ * Required for modems like Fibocom FM350-GL to operate in USB mode.
+ *
+ * Uses LABEL reference (&pcie2) so U-Boot runtime fdt_overlay_apply
+ * resolves the target via base DTB __symbols__ (path reference does not
+ * apply reliably at U-Boot runtime).
+ */
+/dts-v1/;
+/plugin/;
+
+&pcie2 {
+	status = "disabled";
+};
