--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-leds.dtso
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Enable GbE port LEDs on BPI-R4 (MT7988 internal PHYs, ports 0-3).
+ * Hardware-controlled by PHY MAC: blink on link+activity, HNAT-safe.
+ *
+ * fragment/target=<&label> form so it compiles standalone (fixup) and
+ * applies at U-Boot runtime via base DTB __symbols__.
+ * color = <2> is LED_COLOR_ID_GREEN (avoids dt-bindings include).
+ */
+/dts-v1/;
+/plugin/;
+/ {
+	compatible = "bananapi,bpi-r4", "mediatek,mt7988a";
+
+	fragment@0 {
+		target = <&gsw_phy0>;
+		__overlay__ {
+			pinctrl-names = "gbe-led";
+			pinctrl-0 = <&gbe0_led0_pins>;
+		};
+	};
+	fragment@1 {
+		target = <&gsw_phy0_led0>;
+		__overlay__ {
+			status = "okay";
+			color = <2>;
+		};
+	};
+	fragment@2 {
+		target = <&gsw_phy1>;
+		__overlay__ {
+			pinctrl-names = "gbe-led";
+			pinctrl-0 = <&gbe1_led0_pins>;
+		};
+	};
+	fragment@3 {
+		target = <&gsw_phy1_led0>;
+		__overlay__ {
+			status = "okay";
+			color = <2>;
+		};
+	};
+	fragment@4 {
+		target = <&gsw_phy2>;
+		__overlay__ {
+			pinctrl-names = "gbe-led";
+			pinctrl-0 = <&gbe2_led0_pins>;
+		};
+	};
+	fragment@5 {
+		target = <&gsw_phy2_led0>;
+		__overlay__ {
+			status = "okay";
+			color = <2>;
+		};
+	};
+	fragment@6 {
+		target = <&gsw_phy3>;
+		__overlay__ {
+			pinctrl-names = "gbe-led";
+			pinctrl-0 = <&gbe3_led0_pins>;
+		};
+	};
+	fragment@7 {
+		target = <&gsw_phy3_led0>;
+		__overlay__ {
+			status = "okay";
+			color = <2>;
+		};
+	};
+};
