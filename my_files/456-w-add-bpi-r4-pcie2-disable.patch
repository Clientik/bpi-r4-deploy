--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pcie2-disable.dtso
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Disable PCIe2 on BPI-R4 (M.2 Key-B slot) to force FM350-GL
+ * into USB/RNDIS mode. USB lines of the slot remain active.
+ */
+/dts-v1/;
+/plugin/;
+/ {
+	compatible = "bananapi,bpi-r4", "mediatek,mt7988a";
+};
+
+&pcie2 {
+	status = "disabled";
+};
