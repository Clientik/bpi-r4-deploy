config fwupdate 'main'
	# Repo to check (default comes from /etc/fork-release FORK_REPO).
	option repo ''
	# Override the auto-detected release tag / asset (leave empty = auto by
	# RAM + build profile + PoE). Set from LuCI "variant" picker if you want a
	# specific one.
	option tag ''
	option asset ''
	# Daily background check (writes a notice to the log if an update is up).
	option auto_check '1'
